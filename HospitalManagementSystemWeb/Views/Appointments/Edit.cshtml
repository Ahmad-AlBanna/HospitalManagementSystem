</select>

<br />
<br />

<label>Notes</label>
<br />

<textarea id="notes"
          rows="5"
          cols="40"></textarea>

<br />
<br />

<button onclick="updateAppointment()">
    Update
</button>

<script src="~/js/api.js"></script>
