<h1>Create Doctor</h1>

<div class="form-container">

    <input id="username" placeholder="Username">

    <input id="email" type="email" placeholder="Email">

    <input id="password" type="password" placeholder="Password">

    <input id="firstName" placeholder="First Name">

    <input id="lastName" placeholder="Last Name">

    <input id="specialization" placeholder="Specialization">

    <input id="phoneNumber" placeholder="Phone Number">

    <input id="address" placeholder="Address">

    <select id="departmentId"> <option value=""> Select Department</option> </select>

    <button onclick="createDoctor()"> Save Doctor </button>

</div>


<script src="~/js/api.js"></script>

<script src="~/js/Admin/doctors.js"></script>
