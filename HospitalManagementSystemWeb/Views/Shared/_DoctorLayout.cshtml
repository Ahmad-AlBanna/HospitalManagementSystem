<!DOCTYPE html>
<html>

<head>

    <meta charset="utf-8" />

    <title>
        Doctor Portal
    </title>


    <link rel="stylesheet" href="~/css/site.css" />

</head>


<body>


    <div class="container">


        <aside class="sidebar">


            <h2>
                Doctor HMS
            </h2>



            <ul>


                <li>

                    <a asp-controller="Doctor"
                       asp-action="Index">

                        Dashboard

                    </a>

                </li>



                <li>

                    <a asp-controller="Doctor"
                       asp-action="Profile">

                        My Profile

                    </a>

                </li>




                <li>

                    <a asp-controller="Doctor"
                       asp-action="Appointments">

                        My Appointments

                    </a>

                </li>



                <li>

                    <a href="#"
                       onclick="logout()">

                        Logout

                    </a>

                </li>



            </ul>


        </aside>





        <main class="content">


            @RenderBody()


        </main>



    </div>





    <script src="~/js/api.js"></script>


    <script>

        function logout()
        {

        sessionStorage.removeItem("token");

        sessionStorage.removeItem("role");


        window.location =
        "/Authentication/Login";

        }


    </script>



</body>

</html>