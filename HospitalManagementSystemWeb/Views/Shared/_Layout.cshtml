<!DOCTYPE html>
<html>

<head>

    <meta charset="utf-8" />

    <title>
        Hospital Management System
    </title>


    <link rel="stylesheet" href="~/css/site.css" />

</head>


<body>


    <div class="container">


        <aside class="sidebar">


            <h2>
                HMS
            </h2>


            <ul>

                <li>
                    <a href="/Admin/Dashboard">
                        Dashboard
                    </a>
                </li>


                <li>
                    <a href="/Doctors/Index">
                        Doctors
                    </a>
                </li>


                <li>
                    <a href="/Patients/Index">
                        Patients
                    </a>
                </li>


                <li>
                    <a href="/Departments/Index">
                        Departments
                    </a>
                </li>


                <li>
                    <a href="/Appointments/Index">
                        Appointments
                    </a>
                </li>


                <li>
                    <a href="#" onclick="logout()">
                        Logout
                    </a>
                </li>


            </ul>


        </aside>




        <main class="content">


            @RenderBody()


        </main>



    </div>



    <script src="~/js/api.js"></script>


    <script>

        function logout()
        {

        sessionStorage.removeItem("token");

        sessionStorage.removeItem("role");


        window.location =
        "/Authentication/Login";

        }


    </script>


</body>

</html>
